{
  "name": "mhtalk",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run build:prod",
    "build:dev": "tsc && vite build --mode development",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "voice:install": "npm --prefix voice-app install",
    "voice:build": "powershell -ExecutionPolicy Bypass -File scripts/build-voice-sidecar.ps1",
    "worker:dev": "cd worker && npm run dev",
    "worker:deploy": "cd worker && npm run deploy",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:rtc": "node --experimental-strip-types scripts/test-rtc-policy.mjs",
    "check:rtc-architecture": "node scripts/check-rtc-architecture.mjs",
    "check:security-architecture": "node scripts/check-security-architecture.mjs",
    "verify": "npm run check:i18n && npm run test:rtc && npm run check:rtc-architecture && npm run check:security-architecture && npm run check:production && npm run build && npm run voice:web:check && npm run worker:check",
    "voice:web:check": "npm --prefix voice-app run build",
    "worker:check": "npm --prefix worker exec tsc -- --noEmit",
    "check:production": "node scripts/check-production-release.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-sql": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
