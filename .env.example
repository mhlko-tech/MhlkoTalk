VITE_SIGNALING_URL=https://YOUR_WORKER.workers.dev

# Optional production TURN. Order UDP first, then TCP/TLS fallbacks.
# Never commit real credentials. Inject them at build/deployment time.
VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Developer diagnostics are enabled at runtime with localStorage:
# localStorage.setItem('mhtalk.dev.rtcDiagnostics', '1')
