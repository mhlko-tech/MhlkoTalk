{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MHTalkVoice",
  "version": "0.9.1",
  "identifier": "com.mhlko.talk.voice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "voice",
        "title": "MHTalk Voice Engine",
        "width": 1,
        "height": 1,
        "minWidth": 1,
        "minHeight": 1,
        "visible": false,
        "focus": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "dataDirectory": "MHTalkVoiceWebView2"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: tauri: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws: wss: http://127.0.0.1:* http://localhost:*; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
