{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MHTalk",
  "version": "0.9.3",
  "identifier": "com.mhlko.talk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MHTalk",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: tauri: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https: ws: wss: http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob: https://img.youtube.com; media-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/MHTalkVoice"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MDJFNTFBQTdDNDI5MjcKUldRbktjU25HdVVDNUYwZElBaWlRZUxEZTNIL0FrUEVCblRMZ2J4aGtWeGRFdHRwV0d0dm5EWEIK",
      "endpoints": [
        "https://github.com/mhlko-tech/MhlkoTalk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
